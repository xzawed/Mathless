// State machine example (ROADMAP Phase 3): an order's lifecycle as a pure transition function.
//
// The module owns the table, so adding a state or an edge changes one file, not two. The host
// keeps the current state and asks the module where an event leads.
//
// The states and events are `export const`s (SPEC-constants). Each number reaches the generated
// header under a name - ML_ORDER_CONST_PAID - and the interface fingerprint covers it, so a host
// compares against the header's names instead of retyping numbers, and a module whose
// numbering changed is refused at load instead of misread (hosts/c-host/host.c refuses a copy
// with PAID renumbered). The first version of this file wrote each code as a zero-argument
// `fn`, because there were no constants; renumbering one passed the gate silently (STATUS
// section 9-67.2).

error E_BAD_TRANSITION = 1
error E_UNKNOWN_STATE = 2

// States.
export const CREATED = 1
export const PAID = 2
export const SHIPPED = 3
export const DELIVERED = 4
export const CANCELLED = 5
export const REFUNDED = 6

// Events. The same numbers as some states, on purpose: a constant is a name for a value, not
// a unique code, so nothing requires them to differ (SPEC-constants DP-K8).
export const PAY = 1
export const SHIP = 2
export const DELIVER = 3
export const CANCEL = 4
export const REFUND = 5

fn known(state: i32) -> bool {
  return state >= CREATED && state <= REFUNDED
}

// The table. There is no `else` or `match`, so each edge is an early return and anything that
// falls through is refused. An unknown state is checked first so that it gets its own code:
// "this order is in a state I do not know" is a different bug from "this event is not allowed".
export fn next_state(state: i32, event: i32) -> i32! {
  if !known(state) { fail E_UNKNOWN_STATE }
  if state == CREATED && event == PAY { return PAID }
  if state == CREATED && event == CANCEL { return CANCELLED }
  if state == PAID && event == SHIP { return SHIPPED }
  if state == PAID && event == CANCEL { return REFUNDED }
  if state == SHIPPED && event == DELIVER { return DELIVERED }
  if state == DELIVERED && event == REFUND { return REFUNDED }
  fail E_BAD_TRANSITION
}

// A whole sequence, folded through the table. `try` hands a refusal back unchanged, so the host
// sees the same code it would have seen calling next_state one event at a time. The start state
// is checked even with no events - otherwise an empty sequence would return any number as if
// it were a state.
export fn replay(start: i32, events: [i32]) -> i32! {
  if !known(start) { fail E_UNKNOWN_STATE }
  let mut s = start
  let mut i = 0
  while i < len(events) {
    s = try next_state(s, events[i])
    i = i + 1
  }
  return s
}

export fn is_terminal(state: i32) -> bool {
  return state == CANCELLED || state == REFUNDED
}

export fn state_label(state: i32) -> string! {
  if state == CREATED { return "주문됨" }
  if state == PAID { return "결제됨" }
  if state == SHIPPED { return "배송중" }
  if state == DELIVERED { return "배송완료" }
  if state == CANCELLED { return "취소됨" }
  if state == REFUNDED { return "환불됨" }
  fail E_UNKNOWN_STATE
}
